          width: 34px;
          height: 34px;
          background: #e05d50;
          border-radius: 8px;
          display: flex;
          align-items: center;
          justify-content: center;
          color: white;
        }
        .dc-brand-text {
          display: flex;
          flex-direction: column;
          gap: 2px;
