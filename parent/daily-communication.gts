          font-weight: 600;
        }
        .dc-footer dl {
          margin: 10px 0 0;
          display: grid;
          grid-template-columns: 110px 1fr;
          gap: 4px 12px;
          font-size: 11px;
        }
        .dc-footer dt { color: #8a8279; }
        .dc-footer dd { margin: 0; color: #2d3748; word-break: break-all; }
        .dc-footer dd.mono { font-family: ui-monospace, monospace; }
        .dc-footer dd.small { font-size: 10px; }
      </style>
    </template>
  };
}

// ═════════════════════════════════════════════════════════
//   generateDailyCommunication — the actual AI translate flow
//
//   Called from ImportSnapshotManager's UI button. Reads
//   snapshot.rawMarkdown + skillCard.compiledPrompt, calls Gemini via
//   SendRequestViaProxyCommand, parses JSON, constructs + saves a new
//   DailyCommunication card.
// ═════════════════════════════════════════════════════════

export interface GenerateInput {
  // The already-loaded card instances (Component passes them in from model.snapshots + loaded skillCards)
  snapshotCard: any;      // ImportSnapshot instance
  skillCard: any;         // SkillCard instance
  // Host context for commandContext (required by SendRequestViaProxyCommand)
  commandContext: any;
  // parent-daily realm URL where the new DailyCommunication will be saved
  realmHref: string;
}

export interface GenerateResult {
  savedCardId: string;
  model: string;
  latencyMs: number;
  parsedJson: any;
}

export async function generateDailyCommunication(
  input: GenerateInput,
): Promise<GenerateResult> {
  const t0 = performance.now();

  // ── 1. Extract the playbook + the raw observation markdown ──
  const compiledPrompt = String(input.skillCard?.compiledPrompt ?? '').trim();
  const rawMarkdown = String(input.snapshotCard?.rawMarkdown ?? '').trim();

  if (!compiledPrompt) {
    throw new Error(
      'SkillCard compiledPrompt is empty. Check the SkillCard instance.',
    );
  }
  if (!rawMarkdown) {
    throw new Error(
      'ImportSnapshot rawMarkdown is empty. Fetch a snapshot first.',
    );
  }

  // ── 2. Build the system prompt: playbook + append OUTPUT SCHEMA ──
  const outputSchemaInstruction = `

---

## YOUR TASK

You will be given the teacher's raw observation snapshot for one student on
one day. The snapshot includes observations, today's schedule (from daily plan),
and active learning goals. Rewrite it into a warm daily communication that
strictly follows the playbook above.

Return ONLY a valid JSON object matching the schema below. No markdown fences,
no commentary outside the JSON. All text fields must respect the Tone
Guidelines, Prohibited Terms, and Vocabulary Overrides from the playbook.

### OUTPUT SCHEMA

{
  "daySummary": "<one warm sentence capturing the feeling of the student's day>",
  "todayIAte":  "<one short phrase about food/snack if the snapshot mentions it, otherwise 'Not recorded today'>",
  "myDayWas":   "<one of: Great | Good | OK | Hard>",
  "whatIWorkedOn": [
    {
      "subject":     "<domain: Math, Reading, Language, Services, Social Skills, etc.>",
      "description": "<what the student worked on, parent-friendly language, reference the actual activity from schedule/observations>",
      "score":       "<score from observations like '4/5', '8/10', or a check mark '✓' for completed, or '30 min' for duration>"
    }
  ],
  "todaysHighlight": "<a first-person quoted highlight from the child's perspective; pick the best/warmest moment from observations>",
  "teacherNotes":    "<a 2-4 sentence narrative from teacher's warm perspective. Reference specific scores and activities. Mention progress toward learning goals if relevant.>"
}

### RULES

1. If the snapshot is empty, set daySummary to "No observations recorded today" and leave text fields empty strings.
2. The "whatIWorkedOn" array should include ONE entry per academic activity that has a score or was completed. Use the schedule timeline to know the order and the observations for details/scores.
3. Include routine activities (Homeroom, Sensory Break) only if the observations mention something noteworthy about them.
4. "todaysHighlight" must be written as the student speaking in first person — pick the warmest or most impressive moment.
5. "teacherNotes" is where the teacher speaks ABOUT the child (third person). Reference actual scores and learning goal progress.
6. Never mention the student's name in the body text.
7. Use the Active Learning Goals section to understand what the student is working toward — reference goal progress in teacherNotes if observations show improvement.`;

  const systemPrompt = compiledPrompt + outputSchemaInstruction;

  const userPrompt =
    'Here is today\'s raw observation snapshot. Generate the daily communication JSON:\n\n' +
    rawMarkdown;

  // ── 3. Decide model from SkillCard.modelSize (fallback to known-good) ──
  const modelFromSkill = String(input.skillCard?.modelSize ?? '').trim();
  const model =
    modelFromSkill && modelFromSkill.startsWith('google/')
      ? modelFromSkill
      : 'google/gemini-2.0-flash-001';

  console.log(`[generateDC] using model=${model}, systemPrompt len=${systemPrompt.length}, userPrompt len=${userPrompt.length}`);

  // ── 4. Call Gemini via Boxel proxy ──
  const requestBody = JSON.stringify({
    model,
    messages: [
      { role: 'system', content: systemPrompt },
      { role: 'user', content: userPrompt },
    ],
    temperature: 0.4,
    max_tokens: 1200,
  });

  const apiCall = new SendRequestViaProxyCommand(input.commandContext).execute({
    url: 'https://openrouter.ai/api/v1/chat/completions',
    method: 'POST',
    requestBody,
    headers: {
      'Content-Type': 'application/json',
      'HTTP-Referer': 'https://app.boxel.ai',
      'X-Title': 'Tribeca Prep Daily Communication Generator',
    },
  });

  const timeout = new Promise((_r, rej) =>
    setTimeout(() => rej(new Error('AI translate timed out after 30s')), 30000),
  );

  const response: any = await Promise.race([apiCall, timeout]);

  if (response?.response && !response.response.ok) {
    let bodyText = '';
    try { bodyText = await response.response.text(); } catch (_) {}
    throw new Error(
      `HTTP ${response.response.status}: ${response.response.statusText} body: ${bodyText.slice(0, 800)}`,
    );
  }

  // ── 5. Unwrap the response (multi-shape) and extract content ──
  let data: any;
  try {
    if (response?.response?.text) {
      const raw = await response.response.text();
      data = JSON.parse(raw);
    } else if (response?.response?.json) {
      data = await response.response.json();
    } else {
      data = response;
    }
  } catch (_) {
    data = response;
  }

  let content: string =
    data?.choices?.[0]?.message?.content ??
    data?.response?.choices?.[0]?.message?.content ??
    data?.data?.choices?.[0]?.message?.content ??
    (typeof data?.response === 'string' ? data.response : '') ??
    '';

  if (!content && data) {
    try {
      const jsonStr = typeof data === 'string' ? data : JSON.stringify(data);
      const match = jsonStr.match(/"content"\s*:\s*"((?:[^"\\]|\\.)*)"/);
      if (match) content = JSON.parse('"' + match[1] + '"');
    } catch (_) { /* ignore */ }
  }

  const clean = content
    .replace(/^```(?:json)?\s*/i, '')
    .replace(/\s*```$/i, '')
    .trim();

  if (!clean) {
    throw new Error(
      `AI returned empty content. Response keys: ${Object.keys(data ?? {}).join(',')}`,
    );
  }

  let parsed: any;
  try {
    parsed = JSON.parse(clean);
  } catch (e) {
    throw new Error(
      `Failed to parse AI response as JSON: ${e}. Raw content: ${clean.slice(0, 600)}`,
    );
  }

  console.log('[generateDC] parsed JSON', parsed);

  // ── 6. Build the DailyCommunication card ──
  const dc = new DailyCommunication();

  // Traceability (set by command)
  dc.studentSlug = String(input.snapshotCard?.studentSlug ?? '');
  // Convert slug-form "jamie-chen" to display "Jamie Chen" if the stored
  // studentName is actually a slug (ImportSnapshot loadStudents may have
  // fallen back to slug when cross-realm Student firstName/lastName couldn't
  // be resolved synchronously).
  const rawStudentName = String(input.snapshotCard?.studentName ?? '');
  const looksLikeSlug =
    rawStudentName && !/\s/.test(rawStudentName) && rawStudentName.includes('-');
  dc.studentName = looksLikeSlug
    ? rawStudentName
        .split('-')
        .map((w) => (w ? w.charAt(0).toUpperCase() + w.slice(1) : ''))
        .join(' ')
    : rawStudentName;
  // snapshotDate must be a Date instance
  const snapDate = input.snapshotCard?.snapshotDate;
  if (snapDate instanceof Date) {
    (dc as any).snapshotDate = snapDate;
  } else if (typeof snapDate === 'string') {
    (dc as any).snapshotDate = new Date(snapDate);
  } else {
    (dc as any).snapshotDate = new Date();
  }
  dc.sourceSnapshotId = String(input.snapshotCard?.id ?? '');
  dc.sourceSkillCardId = String(input.skillCard?.id ?? '');
  (dc as any).generatedAt = new Date();
  dc.generatedBy = model;

  // AI-generated content
  dc.daySummary = String(parsed?.daySummary ?? '');
  dc.todayIAte = String(parsed?.todayIAte ?? '');
  dc.myDayWas = String(parsed?.myDayWas ?? '');
  dc.todaysHighlight = String(parsed?.todaysHighlight ?? '');
  dc.teacherNotes = String(parsed?.teacherNotes ?? '');

  // whatIWorkedOn containsMany — populate via direct assignment of plain objects
  // (Boxel will coerce to WorkedOnItemField instances)
  const workedRaw = Array.isArray(parsed?.whatIWorkedOn)
    ? parsed.whatIWorkedOn
    : [];
  (dc as any).whatIWorkedOn = workedRaw.map((w: any) => {
    const item = new WorkedOnItemField();
    item.subject = String(w?.subject ?? '');
    item.description = String(w?.description ?? '');
    item.score = String(w?.score ?? '');
    return item;
  });

  // Workflow state
  dc.status = 'draft';
  dc.headTeacherName = 'V. Petrov'; // placeholder, will be real user in Phase 5
  dc.headTeacherRole = 'Head Teacher';
  dc.homeNotes = '';

  // ── 7. Save to parent-daily realm ──
  const { default: SaveCardCommand } = await import(
    '@cardstack/boxel-host/commands/save-card'
  );

  const saveResult: any = await new SaveCardCommand(input.commandContext).execute({
    card: dc,
    realm: input.realmHref,
  });

  const savedCardId =
    saveResult?.savedCard?.id ?? saveResult?.id ?? (dc as any)?.id ?? '';

  const latencyMs = Math.round(performance.now() - t0);
  console.log(`[generateDC] saved DailyCommunication id=${savedCardId} in ${latencyMs}ms`);

  return {
    savedCardId,
    model,
    latencyMs,
    parsedJson: parsed,
  };
}
