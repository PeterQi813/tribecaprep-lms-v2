          flex-shrink: 0;
        }
        .dc-sent-badge .check { font-size: 13px; }

        /* ── Quick row: Today I Ate + My Day Was ── */
        .dc-quick-row {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 12px;
          padding: 20px 24px;
