        }

        /* ── Phase 4: Parent Summary actions bar ── */
        .dc-ps-actions {
          padding: 20px 24px;
          background: #e8f6f4;
          border-top: 2px solid #2a9d8f;
        }
        .dc-ps-intro {
          font-size: 12px;
          color: #4a5568;
          line-height: 1.5;
          margin: 0 0 12px;
        }
        .dc-ps-row {
          display: flex;
          align-items: center;
          gap: 12px;
          margin-bottom: 12px;
        }
        .dc-ps-label {
          font-size: 11px;
          font-weight: 700;
          color: #4a5568;
          text-transform: uppercase;
